# Server-only. Leave blank to disable OTP login and email delivery.
# Set a unique JWT_SECRET of at least 32 characters yourself; never use VITE_ for secrets.
JWT_SECRET=
RESEND_API_KEY=

# Optional public configuration; current UI uses custom OTP, not Clerk.
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Keep 8765: renderer endpoints currently use this fixed port.
SIDECAR_PORT=8765
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral

# M4 investigation agent (all optional; safe defaults shown)
# off | ollama | record | replay — ollama/record accept only a loopback OLLAMA_HOST
DOXSHIELD_LLM_MODE=off
# 1 = fetch vendor privacy policies for analysis (contacts the vendor website)
DOXSHIELD_AGENT_FETCH_POLICIES=
# Fixture backend only: enable the "Acting as" demo identities
DOXSHIELD_DEMO_IDENTITIES=
# JSON map of email -> roles, e.g. {"dpo@example.com": ["approver"]}
DOXSHIELD_ROLES=
DOXSHIELD_AGENT_MAX_TOOL_CALLS=14
DOXSHIELD_APPROVAL_MAX_AGE_SECONDS=86400
